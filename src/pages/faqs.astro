---
import Layout from "../layouts/Layout.astro";
import PageHeroSmall from "../components/PageHeroSmall/PageHeroSmall.astro";
import FaqsList from "../components/Faqs/FaqsList.astro";

import { Page_Seo_Query } from "../data/page/queries";
import { Page_Hero_Small_Query } from "../data/shared/queries";
import { Faqs_Query } from "../data/aboutUs/queries";

const response = await fetch(`${import.meta.env.WPGRAPHQL_URL}`, {
  method: "POST",
  headers: {
    "content-type": "application/json",
  },
  body: JSON.stringify({
    query: `
		query homePageQuery {
			page(id: "/faqs", idType: URI) {
				${Page_Seo_Query}
        faqsPage {
            ${Page_Hero_Small_Query}
            ${Faqs_Query}
        }
			}
		}
	`,
  }),
});

const {
  data: {
    page: { seoMetaTags, faqsPage },
  },
} = await response.json();

// FAQPage schema so questions can appear as rich results
const stripTags = (html = "") => html.replace(/<[^>]*>/g, "").trim();
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: (faqsPage.faqs?.sections ?? [])
    .flatMap((section) => section.category ?? [])
    .flatMap((cat) => cat.questions ?? [])
    .map((quest) => ({
      "@type": "Question",
      name: stripTags(quest.question),
      acceptedAnswer: { "@type": "Answer", text: quest.answer },
    })),
};
---

<Layout
  metaImg={seoMetaTags.seoMetaInformation.metaImage?.node?.sourceUrl}
  metaTitle={seoMetaTags.seoMetaInformation.metaTitle}
  metaDescription={seoMetaTags.seoMetaInformation.metaDescription}
>
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(faqSchema)}
  />
  <PageHeroSmall data={faqsPage.pageHeroSmall} />
  <FaqsList data={faqsPage.faqs} />
</Layout>
