---
// @ts-nocheck
import type { GetStaticPaths } from "astro";
import Layout from "../../layouts/Layout.astro";
import PageHeroSmall from "../../components/PageHeroSmall/PageHeroSmall.astro";
import PostCards from "../../components/PostCards/PostCards.astro";
import Button from "../../components/shared/Button.astro";

import { Page_Seo_Query } from "../../data/page/queries";
import { Page_Hero_Small_Query } from "../../data/shared/queries";

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const response = await fetch(`${import.meta.env.WPGRAPHQL_URL}`, {
    method: "POST",
    headers: {
      "content-type": "application/json",
    },
    body: JSON.stringify({
      query: `
        query postsQuery {
          posts(first: 999999) {
            edges {
              node {
                slug
                title
                postFields {
                  excerpt
                  featuredImage  {
                    node {
                      sourceUrl
                      altText
                      mediaDetails {
                        width
                        height
                      }
                    }
                  }
                }
              }
            }
          }
        }
      `,
    }),
  });

  const { data } = await response.json();
  const allposts = data.posts.edges;
  return paginate(allposts, { pageSize: 4 });
};

const response = await fetch(`${import.meta.env.WPGRAPHQL_URL}`, {
  method: "POST",
  headers: {
    "content-type": "application/json",
  },
  body: JSON.stringify({
    query: `
		query newsResourcesQuery {
			page(id: "/news-resources", idType: URI) {
				${Page_Seo_Query}
        newsResourcesPage {
          ${Page_Hero_Small_Query}
        }
			}
		}
	`,
  }),
});

const {
  data: {
    page: { seoMetaTags, newsResourcesPage },
  },
} = await response.json();

const {
  page,
  page: { data: allPosts },
} = Astro.props;

// Give paginated pages unique titles so they aren't flagged as duplicates
const baseTitle = seoMetaTags.seoMetaInformation.metaTitle;
const metaTitle =
  page.currentPage > 1 && baseTitle
    ? `${baseTitle} - Page ${page.currentPage}`
    : baseTitle;
---

<Layout
  metaImg={seoMetaTags.seoMetaInformation.metaImage?.node?.sourceUrl}
  metaTitle={metaTitle}
  metaDescription={seoMetaTags.seoMetaInformation.metaDescription}
>
  <PageHeroSmall data={newsResourcesPage.pageHeroSmall} />
  <PostCards allPosts={allPosts} />
  {
    page.lastPage > 1 && (
      <nav class="articles-pagination" aria-label="News & Resources pages">
        {page.url.prev && (
          <Button ele="a" btnstyle="two" href={page.url.prev} rel="prev">
            Newer posts
          </Button>
        )}
        <span>
          Page {page.currentPage} of {page.lastPage}
        </span>
        {page.url.next && (
          <Button ele="a" btnstyle="two" href={page.url.next} rel="next">
            Older posts
          </Button>
        )}
      </nav>
    )
  }
</Layout>
